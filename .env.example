APP_NAME=Travelety
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://travelety.com
APP_TIMEZONE=Asia/Dubai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=hello@travelety.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@travelety.com
MAIL_FROM_NAME="${APP_NAME}"

# Flight fare data (server-side only)
FARES_API_TOKEN=
AFFILIATE_MARKER=

# AI writer for blog, route and destination content
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Admin created by the seeder
ADMIN_EMAIL=admin@travelety.com
ADMIN_PASSWORD=

# One-time setup URL key (/_setup/install?key=...). Remove after setup.
SETUP_KEY=
